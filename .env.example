# Copie para .env (desenvolvimento local) ou configure no painel da Vercel (Settings → Environment Variables).

# --- Banco de dados (necessário para produção na Vercel) -------------------------
# Crie um banco Redis grátis em Vercel → Storage → Upstash Redis (ou Marketplace).
# A integração define estas variáveis automaticamente:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (alternativa) UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# (alternativa) Supabase: rode supabase/arena_kv.sql no SQL Editor e defina (chave de SERVIDOR, nunca pública):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessão ---------------------------------------------------------------------
# Opcional. Se vazio, um segredo aleatório é gerado e guardado no banco.
AUTH_SECRET=

# --- Pagamentos -----------------------------------------------------------------
# "mock" (padrão): modo de teste, nenhum valor é cobrado, pagamento é simulado.
# "mercadopago": cobranças reais via PIX e cartão.
PAYMENT_PROVIDER=mock
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# URL pública do site (para o webhook do Mercado Pago), ex.: https://seu-site.vercel.app
PUBLIC_BASE_URL=

# --- Jarvis (IA) -----------------------------------------------------------------
# Opcional: com ao menos uma chave, o Jarvis escreve resumos e sugestões. Sem chaves, o app usa os textos prontos.
# Configure no painel da Vercel (Settings → Environment Variables). Nunca coloque chaves no repositório.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
